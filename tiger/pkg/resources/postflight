#!/bin/sh
# Installer postflight ($1 package, $2 destination).  Only acts on an install to the running system's volume.
# The kext is codeless (a USB match personality that tells the usb backend to use our class driver); hand just that personality to the running kernel now so the
# printer works without a restart.  Failure is harmless: kextd loads it from /System/Library/Extensions at the next boot.
[ "$2" = "/" ] || exit 0
/usr/sbin/kextload -q -p "Canon LBP6200" "/System/Library/Extensions/LBP6200 USB Printing.kext" >/dev/null 2>&1
exit 0
